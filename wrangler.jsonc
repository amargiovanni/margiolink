{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "margiolink",
  "main": "src/index.ts",
  // Capped by the workerd binary pinned inside @cloudflare/vitest-pool-workers
  // (newest it supports is 2026-08-22). Production and tests deliberately share
  // this one date so the suite exercises the same compatibility surface as the
  // deploy. Raise it once the test runner ships a newer pinned runtime.
  "compatibility_date": "2026-08-22",
  "observability": { "enabled": true },
  "vars": {
    "SHORT_DOMAIN": "link.margio.uk",
    "RAW_RETENTION_DAYS": "180"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "margiolink",
      "database_id": "fd2d5190-a283-4236-accf-c2ddb10d3618",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["0 * * * *", "30 3 * * *"]
  },
  // A custom domain, not a plain route. A route matches traffic for a
  // hostname that must already resolve — and `link.margio.uk` had no DNS
  // record at all, so the first deploy attached a route to a name nothing
  // could reach. A custom domain makes wrangler create and own the DNS
  // record and the certificate, so the hostname is part of the deployment
  // rather than a manual dashboard step somebody has to remember.
  //
  // Note the pattern carries no `/*`: a custom domain is the whole
  // hostname, and every path under it reaches this Worker.
  "routes": [
    { "pattern": "link.margio.uk", "custom_domain": true }
  ]
}
